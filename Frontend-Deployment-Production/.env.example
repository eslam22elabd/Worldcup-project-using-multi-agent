# ==============================================================================
# Qubeterra Multi-Agent Collaboration & Deployment Environment Variables
# ==============================================================================

# LLM Provider Configuration
# Required for running live multi-agent discussions (Week 3) and LLM-based sentiment
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Frontend Configuration (Vite)
# The backend URL the frontend connects to. In production/single-container deployment,
# relative URLs or http://localhost:8000 are used.
VITE_API_BASE_URL=http://localhost:8000

# Service Port
PORT=8000

# Sibling Repository Paths (Optional overrides)
# Only specify if your local directory layout differs from sibling folders.
# WEEK3_PROJECT_PATH=../Multi-Agent-Collaboration
# WEEK4_PROJECT_PATH=../Analytics-Intelligence-Layer
